# Use an allow-list so local configs, dotenv files, certificates, and build
# output can never be copied into an image by a broad COPY instruction.
**
!Cargo.toml
!Cargo.lock
!.cargo/
!.cargo/**
!src/
!src/**
!web/
!web/package.json
!web/bun.lock
!web/bunfig.toml
!web/index.html
!web/tsconfig.json
!web/tsconfig.app.json
!web/tsconfig.node.json
!web/vite.config.ts
!web/src/
!web/src/**
!docker-bin/
!docker-bin/**
