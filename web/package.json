{
  "name": "estuary-admin",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "bun test src",
    "test:e2e": "bunx --bun playwright test",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . --error-on-warnings",
    "deadcode": "knip",
    "contract:generate": "bun scripts/config-contract.ts",
    "contract:check": "bun scripts/config-contract.ts --check"
  },
  "dependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "i18next": "^26.5.11",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "knip": "6.43.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
