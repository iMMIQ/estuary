[Unit]
Description=Estuary LLM gateway slot %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=estuary
Group=estuary
EnvironmentFile=/etc/estuary/common.env
EnvironmentFile=/etc/estuary/slots/%i.env
ExecStart=/opt/estuary/slots/%i/current/estuary
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=3700s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/estuary
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
