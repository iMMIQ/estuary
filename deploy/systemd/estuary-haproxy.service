[Unit]
Description=Estuary stable HAProxy frontend
After=network-online.target estuary@a.service estuary@b.service
Wants=network-online.target

[Service]
Type=notify
User=estuary
Group=estuary
RuntimeDirectory=estuary
ExecStartPre=/usr/sbin/haproxy -c -f /etc/estuary/haproxy.cfg
ExecStart=/usr/sbin/haproxy -Ws -f /etc/estuary/haproxy.cfg -p /run/estuary/haproxy.pid
ExecReload=/usr/sbin/haproxy -c -f /etc/estuary/haproxy.cfg
ExecReload=/bin/kill -USR2 $MAINPID
Restart=always
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/estuary
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
