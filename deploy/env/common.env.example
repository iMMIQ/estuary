ESTUARY_DATABASE=/var/lib/estuary/estuary.db
ESTUARY_LOG_JSON=true
ESTUARY_CONTROL_SYNC_INTERVAL_MS=500
ESTUARY_NODE_MUTATION_TIMEOUT_MS=30000
ESTUARY_WITHDRAWAL_DELAY_MS=10000
ESTUARY_SHUTDOWN_GRACE_MS=3660000
RUST_LOG=estuary=info

# Optional legacy environment-backed credentials. New Bearer keys can be
# entered directly in the management UI and are stored as plaintext in SQLite.
# VLLM_API_KEY=replace-me
