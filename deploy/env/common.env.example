ESTUARY_DATABASE=/var/lib/estuary/estuary.db
ESTUARY_LOG_JSON=true
ESTUARY_CONTROL_SYNC_INTERVAL_MS=500
ESTUARY_NODE_MUTATION_TIMEOUT_MS=30000
ESTUARY_WITHDRAWAL_DELAY_MS=10000
ESTUARY_SHUTDOWN_GRACE_MS=3660000
RUST_LOG=estuary=info

# Required when ESTUARY_ADMIN_LISTEN is not a loopback address. When set, the
# management application uses HTTP Basic Auth and automation may use Bearer Auth.
# ESTUARY_ADMIN_TOKEN=replace-with-a-long-random-value

# Global production policy overrides. All supported values are listed by
# `estuary --help`; these examples retain the built-in defaults.
# ESTUARY_QUEUE_MAX_REQUESTS=512
# ESTUARY_QUEUE_MAX_BYTES=268435456
# ESTUARY_RETRY_MAX_ATTEMPTS=1
# ESTUARY_RETRY_STATUSES=429,502,503,504
# ESTUARY_HEALTH_INTERVAL_MS=5000

# Optional legacy environment-backed credentials. New Bearer keys can be
# entered directly in the management UI and are stored as plaintext in SQLite.
# VLLM_API_KEY=replace-me
